local dragData = {
    mode = nil,        -- "move" или "resize"
    edge = nil,
    startInput = nil,
    startPos = nil,
    startSize = nil,
    min = Vector2.new(150, 50)
}

local edges = {
    Top = {
        pos = UDim2.new(0, 0, 0, 0),
        size = UDim2.new(1, 0, 0, 6),
        rx = 0, ry = -1,
        mx = 0, my = 1
    },
    Bottom = {
        pos = UDim2.new(0, 0, 1, -6),
        size = UDim2.new(1, 0, 0, 6),
        rx = 0, ry = 1,
        mx = 0, my = 0
    },
    Right = {
        pos = UDim2.new(1, -6, 0, 0),
        size = UDim2.new(0, 6, 1, 0),
        rx = 1, ry = 0,
        mx = 0, my = 0
    }
}

for edgeName, edgeData in pairs(edges) do
    local edgeButton = Instance.new("TextButton")
    edgeButton.Size = edgeData.size
    edgeButton.Position = edgeData.pos
    edgeButton.BackgroundTransparency = 1
    edgeButton.Text = ""
    edgeButton.AutoButtonColor = false
    edgeButton.Active = true
    edgeButton.ZIndex = 5
    edgeButton.Name = edgeName .. "Edge"
    edgeButton.Parent = Frame
    
    edgeButton.InputBegan:Connect(function(input)
        if isLocked then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and 
           input.UserInputType ~= Enum.UserInputType.Touch then 
            return 
        end
        
        dragData.mode = "resize"
        dragData.edge = edgeData
        dragData.startInput = input.Position
        dragData.startPos = Frame.Position
        dragData.startSize = Frame.AbsoluteSize
    end)
end

TextLabel1.InputBegan:Connect(function(input)
    if isLocked then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and 
       input.UserInputType ~= Enum.UserInputType.Touch then 
        return 
    end
    
    dragData.mode = "move"
    dragData.edge = nil
    dragData.startInput = input.Position
    dragData.startPos = Frame.Position
    dragData.startSize = Frame.AbsoluteSize
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragData.mode then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and 
       input.UserInputType ~= Enum.UserInputType.Touch then 
        return 
    end
    
    local delta = input.Position - dragData.startInput
    
    if dragData.mode == "move" then
        Frame.Position = UDim2.new(
            dragData.startPos.X.Scale,
            dragData.startPos.X.Offset + delta.X,
            dragData.startPos.Y.Scale,
            dragData.startPos.Y.Offset + delta.Y
        )
        UpdateShadow()
        UpdateAvatarPosition()
    elseif dragData.mode == "resize" and dragData.edge then
        local newWidth = math.max(dragData.min.X, dragData.startSize.X + delta.X * dragData.edge.rx)
        local newHeight = math.max(dragData.min.Y, dragData.startSize.Y + delta.Y * dragData.edge.ry)
        
        Frame.Size = UDim2.new(0, newWidth, 0, newHeight)
        Frame.Position = UDim2.new(
            dragData.startPos.X.Scale,
            dragData.startPos.X.Offset - (newWidth - dragData.startSize.X) * dragData.edge.mx,
            dragData.startPos.Y.Scale,
            dragData.startPos.Y.Offset - (newHeight - dragData.startSize.Y) * dragData.edge.my
        )
        UpdateShadow()
        UpdateAvatarPosition()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and 
       input.UserInputType ~= Enum.UserInputType.Touch then 
        return 
    end
    dragData.mode = nil
    dragData.edge = nil
end)
